{
  "name": "dsh-github",
  "version": "0.1.2",
  "description": "DSH plugin: GitHub inbox & PR workflow as a better-sidebar tab (unread badge, category filters, review actions, gated merge).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/NolanHo/DSH-github"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./shared": {
      "types": "./lib/types/shared.d.ts",
      "default": "./lib/shared.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "betterSidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/shared.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "cordis": "^4.0.0-rc.7",
    "dsh-better-sidebar": ">=0.12.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.4",
    "dsh-better-sidebar": "^0.12.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
