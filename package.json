{
  "name": "dsh-github",
  "version": "0.1.0",
  "description": "DSH plugin: GitHub inbox & PR workflow as a better-sidebar tab (unread badge, category filters, review actions, gated merge).",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/NolanHo/DSH-github" },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./shared": { "types": "./lib/types/shared.d.ts", "default": "./lib/shared.js" },
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["betterSidebar"], "platform": "web" }
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "src", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "dsh-better-sidebar": ">=0.12.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": { "optional": true },
    "dsh-better-sidebar": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "dsh-better-sidebar": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
